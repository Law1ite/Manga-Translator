{
  "manifest_version": 3,
  "name": "Manga Translator",
  "version": "1.0.0",
  "description": "Translate text from manga images.",

  "icons": {
    "16": "icons/crest-16.png",
    "32": "icons/crest-32.png",
    "48": "icons/crest-48.png",
    "128": "icons/crest-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/crest-16.png",
      "32": "icons/crest-32.png",
      "48": "icons/crest-48.png",
      "128": "icons/crest-128.png"
    }
  },

  "permissions": [
    "activeTab",
    "scripting"
  ],

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}