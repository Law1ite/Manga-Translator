{
  "manifest_version": 3,
  "name": "Manga Translator",
  "version": "1.0.0",
  "description": "Translate text from manga images.",

  "icons": {
  "16": "icons/logo.jpg",
  "48": "icons/logo.jpg",
  "128": "icons/logo.jpg"
    },

  "action": {
    "default_popup": "popup.html"
  },

  "permissions": [
    "activeTab",
    "scripting"
  ],

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}